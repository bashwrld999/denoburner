{
  "name": "denoburner",
  "version": "3.0.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./src/cli/index.ts"
  },
  "tasks": {
    "dev": "deno run -A ./src/cli/index.ts dev",
    "build": "deno run -A ./src/cli/index.ts build",
    "download": "deno run -A ./src/cli/index.ts download",
    "check": "deno check mod.ts ./src/cli/index.ts",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "lint": {
    "rules": {
      "no-unused-vars": "warn"
    }
  },
  "imports": {
    "citty": "npm:citty@0.2.2",
    "esbuild": "npm:esbuild@^0.25.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1",
    "@cliffy/keypress": "jsr:@cliffy/keypress@^1",
    "@std/fmt": "jsr:@std/fmt@^1",
    "ignore": "npm:ignore@^7.0.3"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
